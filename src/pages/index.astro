---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import SkillBadge from '../components/SkillBadge.astro';
---

<Layout title="Gaetano Coppoletta | Software Engineer, AI Systems & Agent Workflows" description="Software engineer building AI-powered software and reliable systems. Security is part of how I build.">
  <!-- Hero Section -->
  <section class="section">
    <div class="container">
      <div class="grid-2 items-center">
        <div>
          <div class="eyebrow">Software Engineering · AI Systems · Applied Security</div>
          <h1 class="mb-4">I build AI-powered software that makes complex work move faster.</h1>
         
          <div class="flex flex-wrap gap-4">
            <a href="/explore/" class="btn">Explore the Build Lab</a>
            <a href="/about/" class="btn btn-secondary">About me</a>
            <a href="/projects/" class="btn btn-secondary">Projects</a>
          </div>
        </div>
        <div class="flex justify-center">
          <img 
            src="/images/gaetano.jpg" 
            alt="Portrait of Gaetano Coppoletta" 
            class="portrait w-64 h-64 object-cover"
            width="256"
            height="256"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Terminal Strip -->
  <section class="section bg-surface border-y border-stroke">
    <div class="container">
      <Terminal 
        lines={[
          'whoami',
          'echo "Gaetano Coppoletta - Software Developer"',
          'ls -la ~/projects/',
          'cat ~/.bashrc | grep -i "security"',
          'ps aux | grep -i "ocpp"'
        ]}
        prefix="$"
        loop={true}
      />
    </div>
  </section>

  <!-- Highlights Section -->
  <section class="section">
    <div class="container">
      <SectionHeading 
        eyebrow="Recent Work"
        title="Software Engineering & AI Systems"
        subtitle="Production platforms, AI-powered workflows, and security research"
      />
      
      <div class="space-y-8">
        <!-- Oracle Job Card -->
        <Card>
          <h3 class="text-accent mb-3">Oracle - Software Developer, Global Product Security</h3>
          <p class="text-muted mb-4">
            Currently working as a Software Developer at Oracle. I build AI-assisted software and workflow tools for complex product-security work, take end-to-end ownership, and mentor engineers. Quantitative impact and internal deployment details are withheld until public disclosure is approved.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <SkillBadge skill="AI Systems" />
            <SkillBadge skill="Full-stack Engineering" />
            <SkillBadge skill="Product Engineering" />
            <SkillBadge skill="Java" />
            <SkillBadge skill="Workflow Automation" />
            <SkillBadge skill="Applied Security" />
          </div>
          <div class="space-y-2 text-sm">
            <p><strong>Role:</strong> Software Developer, Global Product Security</p>
            <p><strong>Duration:</strong> February 2025 - Present</p>
            <p><strong>Focus:</strong> AI-assisted review, workflow automation, and reliable software ownership</p>
          </div>
        </Card>

        <!-- OCPPStorm Project Card -->
        <Card>
          <h3 class="text-accent mb-3">OCPPStorm: A Comprehensive Fuzzing Tool for OCPP Implementations</h3>
          <p class="text-muted mb-4">
            A comprehensive black box fuzzing tool that identified multiple critical vulnerabilities in OCPP implementations, 
            leading to the discovery of CVEs and improved security for electric vehicle charging infrastructure. 
            The tool employs multiple fuzzing strategies including Random Fuzzer, State Machine Fuzzer, and Isla Fuzzer.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <SkillBadge skill="Python" />
            <SkillBadge skill="Fuzzing" />
            <SkillBadge skill="OCPP" />
            <SkillBadge skill="CVE" />
            <SkillBadge skill="Research" />
            <SkillBadge skill="Protocol Security" />
          </div>
          <div class="space-y-2 text-sm">
            <p><strong>Results:</strong> 6 CVEs discovered and assigned</p>
            <p><strong>Publication:</strong> Network and Distributed System Security (VehicleSec) 2024 - NDSS Symposium</p>
            <p><strong>Impact:</strong> Improved security of electric vehicle charging infrastructure. All the CVEs were addressed and fixed by the OCPP implementers.</p>
          </div>
          <a href="/projects/" class="text-accent hover:text-text transition-colors">Learn more →</a>
        </Card>
      </div>
    </div>
  </section>
</Layout>
