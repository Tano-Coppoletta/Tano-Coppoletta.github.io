---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import SkillBadge from '../components/SkillBadge.astro';
import Terminal from '../components/Terminal.astro';
---

<Layout title="About - Gaetano Coppoletta" description="Software engineer building AI-powered products and reliable systems, with applied security experience.">
  <!-- About Section -->
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <SectionHeading 
            eyebrow="About Me"
            title="Software Engineer · AI Systems & Product Engineering"
          />
          <div class="space-y-6">
            <p>
              Hi, I'm Gaetano Coppoletta.
            </p>
            <p>
              I was born and raised in Sicily, and today I build software and AI-powered systems in the Bay Area. I focus on turning complex workflows into useful, reliable products. Security is part of how I build—not the only thing I build.
            </p>
            <p>
              My journey took me from a small town in Southern Italy, to studying computer engineering at the Politecnico di Torino, then completing a dual degree at the University of Illinois at Chicago with a focus on cybersecurity. Along the way I worked in Italy, Norway, and the United States, building both technical skills and a global perspective.
            </p>
            <p>
              Outside of work, I care deeply about technology, security, and the process of turning ideas into products. My story is about resilience, continuous learning, and building systems that people can trust.
            </p>
          </div>
        </div>
        
        <div class="space-y-6">
          <Card>
            <h3 class="text-accent mb-4">Key Facts</h3>
            <div class="space-y-3">
              <div>
                <div class="text-muted text-sm">Location</div>
                <div>San Francisco, CA</div>
              </div>
              <div>
                <div class="text-muted text-sm">Current Role</div>
                <div>Software Developer, Global Product Security</div>
              </div>
              <div>
                <div class="text-muted text-sm">Interests</div>
                <div>Software Engineering, AI Agents, Product Systems, Applied Security</div>
              </div>
            </div>
          </Card>
          
          <Card>
            <h3 class="text-accent mb-4">Skills</h3>
            <div class="flex flex-wrap gap-2">
              <SkillBadge skill="Python" />
              <SkillBadge skill="JavaScript/TypeScript" />
              <SkillBadge skill="Node.js" />
              <SkillBadge skill="Java" />
              <SkillBadge skill="SQL" />
              <SkillBadge skill="React" />
              <SkillBadge skill="Next.js" />
              <SkillBadge skill="Astro" />
              <SkillBadge skill="REST APIs" />
              <SkillBadge skill="Cloud-native apps" />
              <SkillBadge skill="Vulnerability Management" />
              <SkillBadge skill="Threat Modeling" />
              <SkillBadge skill="Secure SDLC" />
              <SkillBadge skill="Fuzzing" />
              <SkillBadge skill="Penetration Testing" />
              <SkillBadge skill="CVE/CVSS Analysis" />
              <SkillBadge skill="AI for Security" />
              <SkillBadge skill="Git" />
              <SkillBadge skill="Docker" />
              <SkillBadge skill="Kubernetes" />
              <SkillBadge skill="Linux" />
              <SkillBadge skill="CI/CD" />
              <SkillBadge skill="Oracle Cloud Infrastructure" />
              <SkillBadge skill="AWS" />
              <SkillBadge skill="GCP" />
              <SkillBadge skill="Automation scripting" />
              <SkillBadge skill="Data visualization" />
              <SkillBadge skill="Agile development" />
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Terminal Strip -->
  <section class="section bg-surface border-y border-stroke">
    <div class="container">
      <Terminal 
        lines={[
          'cat about.txt',
          'echo "Education: Politecnico di Torino + UIC"',
          'echo "Current: Oracle Global Product Security"',
          'ls -la ~/experience/'
        ]}
        prefix="$"
        loop={true}
      />
    </div>
  </section>

  <!-- Experience Timeline -->
  <section class="section border-y border-stroke" id="experience">
    <div class="container">
      <SectionHeading 
        eyebrow="Experience"
        title="Professional Journey"
        subtitle="My work experience and research contributions"
      />
      
      <div class="timeline">
        <div class="timeline-item">
          <Card>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-accent">Software Developer, Global Product Security</h3>
              <span class="text-muted text-sm">Feb 2025 - Current</span>
            </div>
            <div class="text-muted mb-3">Oracle</div>
            <ul class="space-y-2 text-sm list-disc list-inside">
              <li>Build AI-assisted software and workflow tools for product-security work, including a full-stack advisory-review experience and intake automation.</li>
              <li>Own a mission-critical Java application end to end, improve reliability, and mentor engineers.</li>
              <li>Quantitative impact and internal deployment details are withheld until public disclosure is approved.</li>
            </ul>
          </Card>
        </div>
        
        <div class="timeline-item">
          <Card>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-accent">Technical Co-Founder & CPO</h3>
              <span class="text-muted text-sm">Sep 2023 - Nov 2024</span>
            </div>
            <div class="text-muted mb-3">Contxtual.tv - GorgeousTV</div>
            <ul class="space-y-2 text-sm list-disc list-inside">
              <li>Owned product direction and full-stack execution for a contextual-video product.</li>
              <li>Worked cross-functionally to move product ideas into shipped experiences.</li>
            </ul>
          </Card>
        </div>
        
        <div class="timeline-item">
          <Card>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-accent">Graduate Hourly</h3>
              <span class="text-muted text-sm">Jun 2023 - Dec 2023</span>
            </div>
            <div class="text-muted mb-3">University of Illinois at Chicago</div>
            <ul class="space-y-2 text-sm list-disc list-inside">
              <li>Developed OCPPStorm, a black-box OCPP testing tool.</li>
              <li>The work resulted in six assigned CVEs and a VehicleSec 2024 publication.</li>
            </ul>
          </Card>
        </div>
        
        <div class="timeline-item">
          <Card>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-accent">Research Assistant</h3>
              <span class="text-muted text-sm">Jan 2023 - Jun 2023</span>
            </div>
            <div class="text-muted mb-3">University of Illinois at Chicago</div>
            <ul class="space-y-2 text-sm list-disc list-inside">
              <li>Built program-analysis tools for Python and Java code.</li>
              <li>Contributed to software-security research using AST and program-graph analysis.</li>
            </ul>
          </Card>
        </div>
        
        <div class="timeline-item">
          <Card>
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-accent">Software Engineer</h3>
              <span class="text-muted text-sm">Mar 2021 - Jul 2021</span>
            </div>
            <div class="text-muted mb-3">Feedback Italia</div>
            <ul class="space-y-2 text-sm list-disc list-inside">
              <li>Designed and implemented Android UI tests with UI Automator and Espresso, focusing on critical user flows and regression coverage.</li>
            </ul>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <!-- Community and Leadership -->
  <section class="section border-y border-stroke">
    <div class="container">
      <SectionHeading
        eyebrow="Beyond the job title"
        title="Community & Leadership"
        subtitle="A consistent pattern: earn responsibility quickly, bring people together, and deliver."
      />
      <div class="grid-2">
        <Card>
          <h3 class="text-accent mb-2">Founder · Italian Tech Club</h3>
          <p class="text-muted">Founded a nonprofit connecting technology leaders and tech workers across the Bay Area.</p>
          <p><strong>150+ members in less than one year</strong></p>
        </Card>
        <Card>
          <h3 class="text-accent mb-2">Head of Communication · IEEE-HKN</h3>
          <p class="text-muted">After four months in the communications group, became team lead and led communications for the organization’s most important events of the year.</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="section">
    <div class="container">
      <SectionHeading 
        eyebrow="Education"
        title="Academic Background"
      />
      
      <div class="grid-2">
        <Card>
          <h3 class="text-accent mb-2">MSc in Computer Science</h3>
          <div class="text-muted mb-3">University of Illinois at Chicago • 2022-2023</div>
          <div class="text-sm space-y-2">
            <p><strong>GPA:</strong> 4.0</p>
            <p><strong>Focus:</strong> Web development, AI, cybersecurity, software engineering, Android development</p>
            <p><strong>Thesis:</strong> Cybersecurity with focus on web security</p>
          </div>
        </Card>
        
        <Card>
          <h3 class="text-accent mb-2">MSc in Computer Engineering</h3>
          <div class="text-muted mb-3">Politecnico di Torino • 2021-2023</div>
          <div class="text-sm space-y-2">
            <p><strong>Focus:</strong> Concurrent programming, operating systems, software engineering, cybersecurity, web development</p>
            <p><strong>Specialization:</strong> Advanced software engineering and cybersecurity</p>
          </div>
        </Card>

        <Card>
          <h3 class="text-accent mb-2">BSc in Computer Science</h3>
          <div class="text-muted mb-3">Politecnico di Torino • 2018-2021</div>
          <div class="text-sm space-y-2">
            <p><strong>Focus:</strong> Computer science fundamentals, algorithms, data structures</p>
            <p><strong>Specialization:</strong> Software engineering and systems programming</p>
          </div>
        </Card>
      </div>
    </div>
  </section>
</Layout>
