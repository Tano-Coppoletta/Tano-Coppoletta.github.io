---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portrait from '../assets/gaetano-portrait.jpg';
import { person, facts, about, experience, research, education, skills } from '../data/profile';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'research', label: 'Research' },
  { id: 'education', label: 'Education' },
  { id: 'skills', label: 'Skills' },
  { id: 'contact', label: 'Contact' },
];
---

<Layout title={`${person.name}, Software Engineer`} description={person.description}>
  <header class="top">
    <div class="wrap top-inner">
      <a class="brand" href="#main">{person.name}</a>
      <nav class="nav" aria-label="Sections">
        {sections.map((s) => <a href={`#${s.id}`}>{s.label}</a>)}
      </nav>
      <a class="btn" href={person.resume} download>Download résumé</a>
    </div>
  </header>

  <main id="main" class="wrap">
    <section class="hero">
      <h1>{person.name}</h1>
      <div class="hero-grid">
        <div class="hero-text">
          <p class="role">{person.role}</p>
          <p class="summary" set:html={person.summary} />
          <div class="cta">
            <a class="btn" href={person.resume} download>Download résumé</a>
            <a href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href={person.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </div>
        <Image
          class="hero-photo"
          src={portrait}
          alt={`Portrait of ${person.name}`}
          widths={[200, 320, 400, 640]}
          sizes="(max-width: 720px) 200px, 320px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="sec" id="about">
      <h2>About</h2>
      <div class="body prose" data-reveal>
        {about.map((p) => <p set:html={p} />)}
      </div>
    </section>

    <section class="sec" id="experience">
      <h2>Experience</h2>
      <div class="body">
        {
          experience.map((job) => (
            <article class="row" data-reveal>
              <div class="meta">
                {job.dates}
                <br />
                {job.place}
              </div>
              <div class="main">
                <h3>{job.title}</h3>
                <p class="org">{job.org}</p>
                <ul class="pts">
                  {job.points.map((pt) => <li set:html={pt} />)}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="sec" id="research">
      <h2>Research</h2>
      <div class="body">
        <article class="row" data-reveal>
          <div class="meta">
            {research.meta.map((m, i) => (
              <>
                {i > 0 && <br />}
                {m}
              </>
            ))}
          </div>
          <div class="main">
            <h3>{research.title}</h3>
            {research.paragraphs.map((p) => <p>{p}</p>)}
            <ul class="cves" aria-label="CVEs discovered">
              {
                research.cves.map((c) => (
                  <li>
                    <a
                      href={`https://nvd.nist.gov/vuln/detail/${c}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${c} on the National Vulnerability Database`}
                    >
                      {c}
                    </a>
                  </li>
                ))
              }
            </ul>
            <p>
              <a href={research.paper} target="_blank" rel="noopener noreferrer">Read the paper (PDF)</a>
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="sec" id="education">
      <h2>Education</h2>
      <div class="body">
        {
          education.map((e) => (
            <article class="row" data-reveal>
              <div class="meta">
                {e.dates}
                <br />
                {e.place}
              </div>
              <div class="main">
                <h3>{e.degree}</h3>
                <p class="org">{e.school}</p>
                {e.note && <p class="note">{e.note}</p>}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="sec" id="skills">
      <h2>Skills</h2>
      <div class="body skills">
        {
          skills.map((s) => (
            <div class="row" data-reveal>
              <div class="meta">{s.group}</div>
              <div class="main">
                <p>{s.items}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="sec" id="contact">
      <h2>Contact</h2>
      <div class="body" data-reveal>
        <p class="mail"><a href={`mailto:${person.email}`}>{person.email}</a></p>
        <div class="links">
          <a class="btn" href={person.resume} download>Download résumé</a>
          <a href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={person.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="wrap">
    <div class="foot">
      <span>{person.name}</span>
      <span>{person.location}</span>
    </div>
  </footer>
</Layout>
