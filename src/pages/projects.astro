---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import SkillBadge from '../components/SkillBadge.astro';
import Terminal from '../components/Terminal.astro';
---

<Layout title="Engineering & Research - Gaetano Coppoletta" description="Engineering projects, applied research, and published work from Gaetano Coppoletta.">
  
  <section class="section">
    <div class="container">
      <SectionHeading 
        eyebrow="Projects"
        title="Engineering & Research"
        subtitle="End-to-end software, applied research, and published engineering work"
      />
      
      <div class="space-y-8">
        <!-- OCPPStorm Project -->
        <Card>
          <div class="grid-2 items-start">
            <div>
              <h3 class="text-accent mb-3">OCPPStorm: A Comprehensive Fuzzing Tool for OCPP Implementations</h3>
              <p class="text-muted mb-4">
                A black-box OCPP testing tool developed as graduate research. The work resulted in six assigned CVEs and a paper presented at VehicleSec 2024.
              </p>
              <div class="flex flex-wrap gap-2 mb-4">
                <SkillBadge skill="Java" />
                <SkillBadge skill="Fuzzing" />
                <SkillBadge skill="OCPP" />
                <SkillBadge skill="CVE" />
                <SkillBadge skill="Research" />
                <SkillBadge skill="Protocol Testing" />
              </div>
              <div class="space-y-2 text-sm mb-4">
                <p><strong>Results:</strong> Six CVEs assigned</p>
                <p><strong>Publication:</strong> Network and Distributed System Security (VehicleSec) 2024</p>
                <p><strong>Date:</strong> February 2024</p>
                <p><strong>Impact:</strong> Improved security of electric vehicle charging infrastructure</p>
              </div>
              <div class="flex flex-wrap gap-4">
                <a 
                  href="https://www.ndss-symposium.org/wp-content/uploads/vehiclesec2024-69-paper.pdf" 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="btn"
                >
                  Read Paper →
                </a>
               
              </div>
            </div>
            <div class="flex justify-center">
              <div class="w-48 min-h-32 bg-surface border border-stroke rounded-lg flex flex-col items-center justify-center p-4">
                <span class="text-muted text-sm mb-3 font-medium">OCPPStorm · published research</span>
                <p class="text-sm text-muted text-center">The paper is linked below; technical vulnerability details are omitted here.</p>
              </div>
            </div>
          </div>
        </Card>

      </div>
    </div>
  </section>
    <!-- Terminal Strip -->
    <section class="section bg-surface border-y border-stroke">
      <div class="container">
        <Terminal 
          lines={[
            'cd ocppstorm && ls -la',
            'find . -name "*.py" | wc -l',
            'echo "Published research: VehicleSec 2024"'
          ]}
          prefix="$"
          loop={true}
        />
      </div>
    </section>
 
</Layout>
